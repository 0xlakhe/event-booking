# Local-only example. Copy to `.env` and replace placeholder passwords locally.
# Never commit `.env`. Never reuse hosted Supabase credentials here.

# --- PostgreSQL images / names (provisional; reconcile at TASK-007) ---
POSTGRES_IMAGE=postgres:17-alpine
POSTGRES_DB=eventbook_dev
POSTGRES_TEST_DB=eventbook_test

# Bootstrap administrator used only for explicit local setup (tools service).
POSTGRES_BOOTSTRAP_USER=eventbook_bootstrap
POSTGRES_BOOTSTRAP_PASSWORD=changeme-bootstrap-local-only

# Runtime role used by the backend service (restricted; created in TASK-002).
POSTGRES_RUNTIME_USER=eventbook_runtime
POSTGRES_RUNTIME_PASSWORD=changeme-runtime-local-only

# Migration/seed role used only by the tools service (privileged; created in TASK-002).
POSTGRES_MIGRATION_USER=eventbook_migrator
POSTGRES_MIGRATION_PASSWORD=changeme-migration-local-only

# Test roles used only by the tools service (isolated; created in TASK-002).
POSTGRES_TEST_RUNTIME_USER=eventbook_test_runtime
POSTGRES_TEST_RUNTIME_PASSWORD=changeme-test-runtime-local-only
POSTGRES_TEST_MIGRATION_USER=eventbook_test_migrator
POSTGRES_TEST_MIGRATION_PASSWORD=changeme-test-migration-local-only

# --- Backend runtime (backend service only) ---
# Restricted runtime URL. Password comes from POSTGRES_RUNTIME_PASSWORD above.
DATABASE_URL=postgresql+psycopg://eventbook_runtime:changeme-runtime-local-only@db:5432/eventbook_dev
ALLOWED_ORIGINS=http://localhost:3000
APP_ENV=development
# Bounded pool per TECHNICAL_DESIGN.md (size 5, no overflow).
DB_POOL_SIZE=5
DB_CONNECT_TIMEOUT=3
# Expected Alembic head for /health readiness. Initial revision from TASK-002.
# Passed to backend and tools only; never to the frontend.
EXPECTED_ALEMBIC_REVISION=0001_initial

# --- Migration / seed (tools service only; not passed to backend or frontend) ---
MIGRATION_DATABASE_URL=postgresql+psycopg://eventbook_migrator:changeme-migration-local-only@db:5432/eventbook_dev
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=changeme-admin-local-only
SEED_USER_EMAIL=user@example.com
SEED_USER_PASSWORD=changeme-user-local-only

# --- Isolated tests (tools service only) ---
TEST_DATABASE_URL=postgresql+psycopg://eventbook_test_runtime:changeme-test-runtime-local-only@db:5432/eventbook_test
TEST_MIGRATION_DATABASE_URL=postgresql+psycopg://eventbook_test_migrator:changeme-test-migration-local-only@db:5432/eventbook_test

# --- Frontend (frontend service only; public, no secrets) ---
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api
# Production note: set to the deployed HTTPS API URL at frontend image
# BUILD time (baked into the bundle). Backend production uses the
# Supabase session-mode pooler DATABASE_URL plus ALLOWED_ORIGINS set to
# the exact deployed frontend origin. Nothing here is deployed yet.
